{
  "name": "crm-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets Claude or ChatGPT read and update CRM data safely, with a permission policy and an audit log.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "crm",
    "ai-agents"
  ],
  "author": "Muhammad Hassan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "bin": {
    "crm-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ]
}
